---
import type { PaperEntry } from '../lib/papers';
import {
  evidenceLabel,
  formatAuthors,
  formatDate,
  paperDate,
  paperHref,
  priorityRank,
} from '../lib/papers';
import StatusBadge from './StatusBadge.astro';

interface Props {
  paper: PaperEntry;
}

const { paper } = Astro.props;
const { data } = paper;
const category = data.topics[0] || data.tags[0] || '';
const abstractText = data.abstract || data.hook;
const searchText = [
  data.title,
  data.hook,
  data.authors.join(' '),
  data.venue,
  data.tags.join(' '),
  data.topics.join(' '),
  data.organisms.join(' '),
  data.modalities.join(' '),
]
  .filter(Boolean)
  .join(' ')
  .toLocaleLowerCase();
const date = paperDate(paper);
---

<li
  class="paper-row"
  data-paper
  data-slug={data.slug}
  data-title={data.title}
  data-category={category}
  data-date={date.toISOString()}
  data-priority={data.priority}
  data-priority-rank={priorityRank(data.priority)}
  data-progress={data.progress}
  data-tags={JSON.stringify(data.tags.map((tag) => tag.toLocaleLowerCase()))}
  data-search={searchText}
>
  <article
    data-slug={data.slug}
    data-title={data.title}
    data-category={category}
    data-date={date.toISOString()}
    data-priority={data.priority}
    data-priority-rank={priorityRank(data.priority)}
    data-progress={data.progress}
    data-tags={JSON.stringify(data.tags.map((tag) => tag.toLocaleLowerCase()))}
    data-search={searchText}
  >
    <div class="paper-row__date">
      <time datetime={date.toISOString()} class="date-chip">{formatDate(date)}</time>
      <span class="venue-chip">{data.venue ?? data.source}</span>
    </div>
    <div class="paper-row__body">
      <h2><a href={paperHref(paper)}>{data.title}</a></h2>
      <p class="paper-row__authors">{formatAuthors(data.authors)}</p>
      <p class="paper-row__hook">{data.hook}</p>
      {abstractText && (
        <details class="paper-row__abstract">
          <summary class="abstract-toggle">Read full abstract</summary>
          <div class="abstract-panel">
            <p>{abstractText}</p>
          </div>
        </details>
      )}
      {data.tags.length > 0 && (
        <ul class="tag-list" aria-label="Topics">
          {data.tags.slice(0, 5).map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>
    <div class="paper-row__state">
      <div class="paper-row__badges">
        <StatusBadge value={data.priority} kind="priority" />
        <StatusBadge value={data.progress} kind="progress" />
        <span class="triage-badge" data-triage-badge hidden></span>
      </div>
      <span class="evidence-note">{evidenceLabel(data.evidence.scope)}</span>
      <div class="triage-btn-group">
        <button
          type="button"
          class="triage-btn triage-btn--deep-dive"
          data-triage-action="deep-dive"
          title="Mark for deep-dive summary"
        >
          ✨ Deep Dive
        </button>
        <button
          type="button"
          class="triage-btn triage-btn--archive"
          data-triage-action="archived"
          title="Archive candidate"
        >
          🗑️ Archive
        </button>
        <button
          type="button"
          class="triage-btn triage-btn--reset"
          data-triage-action="reset"
          title="Reset triage decision"
          hidden
        >
          ↺ Reset
        </button>
      </div>
    </div>
  </article>
</li>

<style>
  .paper-row {
    border-top: 1px solid var(--color-rule);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .paper-row:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  article {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.75fr) minmax(0, 3.2fr) minmax(11.5rem, 1.15fr);
    gap: clamp(1rem, 2.5vw, 2.25rem);
    padding: clamp(1.3rem, 2.5vw, 2rem) 0;
    align-items: start;
  }

  .paper-row__date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .date-chip {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .venue-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    background: var(--color-surface-muted);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.2;
    width: fit-content;
  }

  .paper-row__body {
    min-width: 0;
  }

  h2 {
    max-width: 44ch;
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-accent-strong);
  }

  h2 a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.25rem;
  }

  .paper-row__authors {
    margin-top: 0.45rem;
    color: var(--color-muted);
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .paper-row__hook {
    max-width: 66ch;
    margin-top: 0.75rem;
    color: var(--color-ink-soft);
    font-size: 0.94rem;
    line-height: 1.58;
  }

  .paper-row__abstract {
    margin-top: 0.65rem;
    border: none;
    background: transparent;
    padding: 0;
  }

  .paper-row__abstract summary {
    list-style: none;
  }

  .paper-row__abstract summary::-webkit-details-marker {
    display: none;
  }

  .paper-row__abstract[open] .abstract-toggle {
    background: var(--color-surface-hover);
    border-color: var(--color-rule-strong);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }

  .tag-list li {
    padding: 0.12rem 0.45rem;
    background: var(--color-surface-muted);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .paper-row__state {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
    justify-self: end;
  }

  .paper-row__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.4rem;
  }

  .evidence-note {
    max-width: 14rem;
    text-align: right;
    color: var(--color-muted);
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .triage-btn-group {
    margin-top: 0.25rem;
    justify-content: flex-end;
  }

  .triage-btn[hidden],
  [data-triage-badge][hidden] {
    display: none !important;
  }

  @media (max-width: 50rem) {
    article {
      grid-template-columns: 1fr auto;
      gap: 1.25rem;
    }

    .paper-row__date {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
    }

    .paper-row__body {
      grid-column: 1;
    }

    .paper-row__state {
      grid-column: 2;
      align-items: flex-end;
    }
  }

  @media (max-width: 36rem) {
    article {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.35rem 0;
    }

    .paper-row__date {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
    }

    .paper-row__state {
      width: 100%;
      align-items: flex-start;
      margin-top: 0.5rem;
      gap: 0.65rem;
    }

    .paper-row__badges {
      justify-content: flex-start;
      width: 100%;
    }

    .evidence-note {
      text-align: left;
      max-width: 100%;
    }

    .triage-btn-group {
      width: 100%;
      justify-content: stretch;
      gap: 0.5rem;
    }

    .triage-btn {
      flex: 1 1 calc(50% - 0.25rem);
      justify-content: center;
    }

    .triage-btn--reset {
      flex: 1 1 100%;
    }
  }

  @media (max-width: 32rem) {
    article {
      padding: 1.15rem 0;
      gap: 0.85rem;
    }

    .triage-btn {
      min-height: 2.75rem; /* >= 44px touch target (AAA) */
      font-size: 0.82rem;
    }

    .triage-btn--reset {
      min-height: 2.75rem;
    }

    .abstract-toggle {
      min-height: 2.75rem; /* >= 44px touch target */
      width: 100%;
      justify-content: center;
    }
  }
</style>
