---
import PapersExplorer from '../../components/PapersExplorer.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPapers } from '../../lib/papers';

const papers = await getPapers();
---

<PageLayout
  title="Paper catalog"
  eyebrow="Curated Literature Catalog"
  lead="Browse curated computational genomics literature arranged by chronological Timeline date clusters, structured research Categories, or custom filters. Inspect complete abstracts, review editorial takeaways, and track reading progress—every view provides a shareable URL."
>
  <PapersExplorer papers={papers} />
</PageLayout>
